# Скопируй в .env и заполни
# cp .env.example .env
#
# С версии с экраном логина учётные данные iiko (адрес сервера, логин,
# пароль) больше не хранятся здесь — пользователь вводит их прямо
# в веб-интерфейсе при входе. Эти переменные нужны только для
# инфраструктурных настроек самого приложения.

# Порт, на котором слушает backend внутри контейнера
PORT=3001

# production | development — влияет на флаг secure у cookie сессии
NODE_ENV=production
