# Скопируй в .env и заполни
# cp .env.example .env
#
# С версии с экраном логина учётные данные iiko (адрес сервера, логин,
# пароль) больше не хранятся здесь — пользователь вводит их прямо
# в веб-интерфейсе при входе. Эти переменные нужны только для
# инфраструктурных настроек самого приложения.

# Порт, на котором слушает backend внутри контейнера
PORT=3001

# production | development
NODE_ENV=production

# true | false (по умолчанию false) — управляет флагом Secure у cookie
# сессии. Secure-cookie браузер отправляет ТОЛЬКО по HTTPS — если сайт
# открывается по http:// (обычный случай для Docker в локальной сети или
# по IP-адресу без сертификата), включение этого флага приведёт к тому,
# что сессия будет теряться сразу после входа: первая же навигация на
# другую страницу отправит запрос без cookie, сервер ответит 401, и
# фронтенд откатится на экран логина (внешне выглядит как «пропадает
# боковое меню при клике на пункт меню»).
# Включай COOKIE_SECURE=true только если дашборд действительно открыт
# по https:// (домен + TLS-сертификат, например через Caddy/Nginx с
# Let's Encrypt или через прокси уровня платформы хостинга).
COOKIE_SECURE=false

# Список разрешённых источников (Origin) через запятую, например:
# ALLOWED_ORIGINS=https://dashboard.example.com,https://www.example.com
# Если не задано — в целях удобства разработки разрешаются любые источники.
# В production рекомендуется явно указать домен(ы) фронтенда.
ALLOWED_ORIGINS=

# Сессии авторизации хранятся ТОЛЬКО в памяти процесса (см. sessionStore.js).
# Учётные данные iiko никогда не попадают на диск ни в каком виде — это
# сознательный компромисс безопасности: при перезапуске/обновлении
# контейнера все пользователи будут разлогинены и должны войти заново.
